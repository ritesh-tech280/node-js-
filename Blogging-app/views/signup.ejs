<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head') %>

  <body class="bg-gray-900 text-white min-h-screen">
    <%- include('./partials/nav') %>

    <div class="flex justify-center px-4 py-12">
      <div class="w-full max-w-md">
        <h1 class="text-3xl font-bold text-center mb-8">Create an Account</h1>

        <form
          action="/user/signup"
          method="post"
          class="bg-gray-800 border border-gray-700 rounded-xl p-8 shadow-lg"
        >
          <!-- Name -->
          <div class="mb-6">
            <label
              for="name"
              class="block mb-2 text-sm font-medium text-gray-200"
            >
              Name
            </label>

            <input
              type="text"
              id="name"
              name="name"
              placeholder="Enter your name"
              required
              class="w-full px-4 py-3 rounded-lg bg-gray-900 border border-gray-600 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          <div class="mb-6">
            <label
              for="email"
              class="block mb-2 text-sm font-medium text-gray-200"
            >
              Email Address
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="name@example.com"
              required
              class="w-full px-4 py-3 rounded-lg bg-gray-900 border border-gray-600 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <!-- Password -->
          <div class="mb-6">
            <label
              for="password"
              class="block mb-2 text-sm font-medium text-gray-200"
            >
              Password
            </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              required
              class="w-full px-4 py-3 rounded-lg bg-gray-900 border border-gray-600 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full px-5 py-3 text-white font-medium bg-blue-600 hover:bg-blue-700 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-800 transition"
          >
            Create Account
          </button>

          <!-- Login -->
          <p class="mt-6 text-center text-sm text-gray-400">
            Already have an account?
            <a
              href="/user/signin"
              class="text-blue-400 hover:text-blue-300 hover:underline"
            >
              Sign In
            </a>
          </p>
        </form>
      </div>
    </div>
  </body>
</html>
