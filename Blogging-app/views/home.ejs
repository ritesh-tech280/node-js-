<!DOCTYPE html>
<html lang="en">
    <head>
 <%- include('./partials/head') %>
 <title>Home Page</title>
 </head>
<body>
    <%- include('./partials/nav')  %>
     
    
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-6">

  <% blogs.forEach(blog => { %>

    <div
      class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden shadow-lg hover:border-gray-700 hover:shadow-xl transition duration-300"
    >

      <!-- Cover Image -->
      <a href="#">
        <img
          class="w-full h-52 object-cover"
          src="<%= blog.coverImageUrl %>"
          alt="<%= blog.title %>"
        />
      </a>

      <!-- Card Content -->
      <div class="p-5">

        <!-- Title -->
        <a href="#">
          <h5
            class="mb-3 text-xl font-semibold tracking-tight text-white hover:text-red-400 transition"
          >
            <%= blog.title %>
          </h5>
        </a>

        <!-- Content -->
        <p class="mb-5 text-gray-400 leading-relaxed">
          <%= blog.body %>
        </p>

        <!-- Read More Button -->
        <a
          href="#"
          class="inline-flex items-center px-4 py-2.5 text-sm font-medium text-white bg-red-500 rounded-lg hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500/40 transition"
        >
          Read more

          <svg
            class="w-4 h-4 ml-2"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 12H5m14 0-4 4m4-4-4-4"
            />
          </svg>
        </a>

      </div>
    </div>

  <% }); %>

</div>
 


    
 

   <%- include('./partials/scripts')  %>
</body>
</html>