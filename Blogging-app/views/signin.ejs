
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Login</title>
  </head>

  <body class="bg-gray-900 text-white min-h-screen">
    <%- include('./partials/nav') %>

    <% if (locals.error) { %>
  <div class="max-w-md m-auto mt-10">
    <div class="flex items-start sm:items-center p-4 mb-4 text-sm text-fg-danger-strong rounded-base bg-danger-soft border border-danger-subtle" role="alert">
  <svg class="w-4 h-4 me-2 shrink-0 mt-0.5 sm:mt-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
  <p><span class="font-medium me-1">
    <%= locals.error %>
  </p>
</div>
</div>
<% } %>

    <div class="flex justify-center px-4 py-12">
      <div class="w-full max-w-md">

        <h1 class="text-3xl font-bold text-center mb-8">
         Sign In 
        </h1>

        <form
          action="/user/signin"
          method="POST"
          class="bg-gray-800 border border-gray-700 rounded-xl p-8 shadow-lg"
        >

         <!-- Email  -->
          <div class="mb-6">
            <label
              for="email"
              class="block mb-2 text-sm font-medium text-gray-200"
            >
              Email Address
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="name@example.com"
              required
              class="w-full px-4 py-3 rounded-lg
                     bg-gray-900 border border-gray-600
                     text-white placeholder-gray-500
                     focus:outline-none focus:ring-2 focus:ring-red-500
                     focus:border-red-500"
            />
          </div>

          <!-- Password -->
          <div class="mb-6">
            <label
              for="password"
              class="block mb-2 text-sm font-medium text-gray-200"
            >
              Password
            </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              required
              class="w-full px-4 py-3 rounded-lg
                     bg-gray-900 border border-gray-600
                     text-white placeholder-gray-500
                     focus:outline-none focus:ring-2 focus:ring-red-500
                     focus:border-red-500"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full px-5 py-3
                   text-white font-medium
                   bg-red-500 hover:bg-red-600
                   rounded-lg
                   focus:outline-none focus:ring-4 focus:ring-red-800
                   transition"
          >
       Sign In
          </button>

          <!-- Login -->
          <p class="mt-6 text-center text-sm text-gray-400">
            Don't have an account?
            <a
              href="/user/signup"
              class="text-blue-400 hover:text-blue-300 hover:underline"
            >
            Signup 
            </a>
          </p>

        </form>
      </div>
    </div>
  </body>
</html>
 
