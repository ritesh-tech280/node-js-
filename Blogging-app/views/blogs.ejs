
<!DOCTYPE html>
<html lang="en">
<head>
 <%- include('./partials/head') %>
  <title>Blogs</title>
 
</head>

<body class="bg-gray-950 text-gray-200">

  <!-- Navbar -->
  <%- include('./partials/nav')  %>


  <!-- Blog -->

  <% blogs %>
  <main class="container mx-auto px-5 py-10">

    <article class="max-w-4xl mx-auto">

      <!-- Blog Title -->
      <h1 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-5">
        <%= blog.title %>
      </h1>


      <!-- Blog Meta -->
      <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-8">

        <% if (blog.author) { %>
          <span>
            By <span class="text-gray-300"><%= blog.author %></span>
          </span>
        <% } %>

        <% if (blog.createdAt) { %>
          <span>•</span>
          <span>
            <%= new Date(blog.createdAt).toLocaleDateString() %>
          </span>
        <% } %>

      </div>


      <!-- Cover Image -->
      <% if (blog.coverImageUrl) { %>

        <div class="mb-10">
          <img
            src="<%= blog.coverImageUrl %>"
            alt="<%= blog.title %>"
            class="w-full max-h-[500px] object-cover rounded-xl border border-gray-800"
          >
        </div>

      <% } %>


      <!-- Blog Content -->
      <div
        class="text-gray-300 text-lg leading-8 whitespace-pre-line"
      >
        <%= blog.body %>
      </div>


      <!-- Bottom -->
      <div class="mt-12 pt-6 border-t border-gray-800">

        <a
          href="/"
          class="inline-flex items-center px-5 py-3 bg-red-500 hover:bg-red-600 text-white rounded-lg font-medium transition"
        >
          ← Back to Blogs
        </a>

      </div>

    </article>

  </main>

</body>
</html>

